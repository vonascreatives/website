{"_id":"intern-training-program","_type":"kb","title":"Intern Training Program","kind":"page","parent":{"_type":"reference","_ref":"kb.company.interns"},"slug":{"current":"intern-training-program"},"description":"Comprehensive training program for new interns","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"Intern Training Program"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Our 2-week training program is designed to give interns the skills and knowledge they need to contribute meaningfully to our projects."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Week 1: Foundation"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Day 1-2: Company culture and values"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Day 3-4: Tools and workflows"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Day 5: Shadow experienced team members"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Week 2: Hands-On"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Day 1-3: Small project assignments"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Day 4-5: Present completed work and get feedback"}]}],"tags":["interns","training","program"]}
{"_id":"otr-guest-preparation","_type":"kb","title":"OTR Guest Preparation Guide","kind":"page","parent":{"_type":"reference","_ref":"kb.shows.otr.pre-production"},"slug":{"current":"otr-guest-prep"},"description":"Complete guide for preparing guests for OTR recordings","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"Guest Preparation for OTR"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Proper guest preparation ensures smooth recordings and engaging content. Follow this guide for every OTR guest."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Pre-Interview (1 Week Before):"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Send welcome packet with show format overview"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Schedule 15-minute tech check call"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Share talking points and potential questions"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Day of Recording:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Confirm guest is ready 30 minutes before"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Test audio and video quality"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Brief on any last-minute changes"}]}],"tags":["otr","guests","preparation","pre-production"]}
{"_id":"otr-editing-workflow","_type":"kb","title":"OTR Video Editing Workflow","kind":"page","parent":{"_type":"reference","_ref":"kb.shows.otr.post-production"},"slug":{"current":"otr-editing-workflow"},"description":"Step-by-step workflow for editing OTR episodes","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"OTR Editing Workflow"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"This workflow ensures consistent quality and timing for all OTR episodes."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Step 1: Initial Setup"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Import raw footage to DaVinci Resolve"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Create project with OTR template"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Sync all audio and video tracks"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Step 2: Content Edit"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Remove long pauses and filler words"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Maintain natural conversation flow"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Add transition slides between topics"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Step 3: Final Polish"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Apply color correction"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Add intro and outro graphics"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Export in multiple formats for distribution"}]}],"tags":["otr","editing","workflow","post-production"]}
{"_id":"davinci-setup-guide","_type":"kb","title":"DaVinci Resolve Setup Guide","kind":"page","parent":{"_type":"reference","_ref":"kb.tools.editing-design.davinci"},"slug":{"current":"davinci-setup"},"description":"Complete setup guide for DaVinci Resolve with our templates and preferences","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"DaVinci Resolve Setup"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Follow this guide to set up DaVinci Resolve with our standard templates and preferences."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Initial Installation:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Download from Blackmagic Design website"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Install with default settings"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Launch and complete initial setup wizard"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Template Setup:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Import Vonas Media project templates"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Set up custom keyboard shortcuts"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Configure preferred render settings"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Performance Optimization:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Set cache location to fastest drive"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Configure GPU acceleration"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Adjust memory allocation for smooth playback"}]}],"tags":["davinci","resolve","setup","editing","tools"]}
{"_id":"slack-best-practices","_type":"kb","title":"Slack Communication Best Practices","kind":"page","parent":{"_type":"reference","_ref":"kb.tools.comms-ops.slack"},"slug":{"current":"slack-best-practices"},"description":"Guidelines for effective communication using Slack","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"Slack Communication Best Practices"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Follow these guidelines to maintain clear, efficient communication in Slack."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Channel Usage:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• #general - Company-wide announcements"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• #production - Show production coordination"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• #random - Casual conversation and team building"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Message Guidelines:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Use threads for detailed discussions"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• React with emojis to acknowledge messages"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Use @here sparingly - only for urgent team needs"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Status Updates:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Set status when away or focused"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Use descriptive away messages"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Update regularly to keep team informed"}]}],"tags":["slack","communication","best-practices","tools"]}
{"_id":"partner-brand-guidelines","_type":"kb","title":"Brand Partnership Guidelines","kind":"page","parent":{"_type":"reference","_ref":"kb.partners.brands"},"slug":{"current":"brand-partnership-guidelines"},"description":"Guidelines for working with brand partners and sponsors","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"Brand Partnership Guidelines"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Maintain authenticity while delivering value to brand partners with these guidelines."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Content Integration:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Always disclose partnerships clearly"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Integrate mentions naturally into content"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Maintain editorial independence"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Approval Process:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Share content drafts 48 hours before publish"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Allow one round of reasonable feedback"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Maintain creative control over final output"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Performance Reporting:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Provide agreed-upon metrics within 7 days"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Include engagement and reach data"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Add qualitative insights when relevant"}]}],"tags":["partners","brands","guidelines","sponsorship"]}
{"_id":"influencer-collaboration","_type":"kb","title":"Influencer Collaboration Process","kind":"page","parent":{"_type":"reference","_ref":"kb.partners.influencers"},"slug":{"current":"influencer-collaboration"},"description":"Process for identifying and working with influencer partners","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"Influencer Collaboration Process"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Build authentic relationships with influencers that align with our brand values and audience."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Identification:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Research influencers in our niche"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Check engagement rates, not just follower counts"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Ensure values alignment"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Outreach:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Personalized initial contact"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Clear collaboration proposal"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Flexible terms to build long-term relationships"}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Collaboration:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Co-create content concepts"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Provide creative freedom within brand guidelines"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Support with resources and promotion"}]}],"tags":["partners","influencers","collaboration","outreach"]}
