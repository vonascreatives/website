{"_id":"company-policies-guide","_type":"kb","title":"Company Policies Guide","kind":"page","parent":{"_type":"reference","_ref":"kb.company.policies"},"slug":{"current":"company-policies-guide"},"description":"Comprehensive guide to company policies including remote work, communication, and expenses","order":1,"content":[{"_type":"block","style":"h2","children":[{"_type":"span","text":"Remote Work Policy"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Our remote work policy allows for flexible work arrangements while maintaining productivity and collaboration standards."}]},{"_type":"block","style":"h3","children":[{"_type":"span","text":"Key Guidelines:"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Core hours: 10 AM - 3 PM local time for overlap"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Daily standup at 10 AM via Slack"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Weekly team sync every Tuesday"}]},{"_type":"block","style":"h2","children":[{"_type":"span","text":"Communication Guidelines"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"Clear communication is essential for remote teams. Use the appropriate channel for different types of messages."}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Slack: Quick questions, daily updates"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Email: Formal communications, external contacts"}]},{"_type":"block","style":"normal","children":[{"_type":"span","text":"• Zoom: Meetings, complex discussions"}]}],"tags":["policies","remote","guidelines"]}
